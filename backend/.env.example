# --- MongoDB ---
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/gdgoc-gcee
# Set FORCE_DNS when the local network DNS refuses SRV lookups (Mongo "querySrv ECONNREFUSED").
# FORCE_DNS=8.8.8.8,1.1.1.1

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=30d
COOKIE_SECURE=false

# --- App ---
PORT=5000
# PUBLIC_APP_URL overrides VERCEL_PROJECT_PRODUCTION_URL (Vercel's auto-injected
# internal hostname) for certificate email links. Set this in the Vercel dashboard.
PUBLIC_APP_URL=https://gdgoc-gcee.vercel.app
APP_URL=https://gdgoc-gcee.vercel.app
CLIENT_URL=https://gdgoc-gcee.vercel.app
NEXT_PUBLIC_APP_URL=https://gdgoc-gcee.vercel.app
VITE_APP_URL=https://gdgoc-gcee.vercel.app
NODE_ENV=development

# --- Vercel production (set these in the Vercel dashboard, NOT in .env files) ---
# MONGODB_URI       -> your MongoDB Atlas connection string
# JWT_SECRET        -> a long random string
# PUBLIC_APP_URL    -> https://gdgoc-gcee.vercel.app  (HIGHEST priority; overrides auto-injected VERCEL_PROJECT_PRODUCTION_URL)
# APP_URL           -> https://gdgoc-gcee.vercel.app  (used for event emails + certificate verify links)
# CLIENT_URL        -> https://gdgoc-gcee.vercel.app  (same as APP_URL)
# COOKIE_SECURE     -> defaults to true when NODE_ENV=production; leave unset unless you need to override

# --- Initial admin (used only by the seed script) ---
ADMIN_NAME=GDGoC GCEE Admin
ADMIN_EMAIL=admin@gdgocgcee.in
ADMIN_PASSWORD=Admin@123

# --- Email ---
# SITE_EMAIL is the ONE official club email: default sender identity and
# the Contact-Us recipient. GMAIL_USER / CONTACT_RECIPIENT_EMAIL fall back
# to it automatically when unset.
SITE_EMAIL=gceegdgoc@gmail.com

# --- Email: Normal Website / OTP (Gmail SMTP via Nodemailer) ---
GMAIL_USER=gceegdgoc@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# --- Email: Contact Us Form Only (Resend API) ---
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=GDGoC GCEE
CONTACT_RECIPIENT_EMAIL=gceegdgoc@gmail.com
